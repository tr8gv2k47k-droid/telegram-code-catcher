<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Telegram Code Catcher</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 2rem;
        background: #0f172a;
        color: #e2e8f0;
      }
      h1 {
        margin-bottom: 1rem;
      }
      .snippet {
        background: #111827;
        border: 1px solid #334155;
        border-radius: 10px;
        padding: 1rem;
        margin: 1rem 0;
      }
      .meta {
        color: #94a3b8;
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
      }
      pre {
        white-space: pre-wrap;
        word-wrap: break-word;
        background: #020617;
        padding: 1rem;
        border-radius: 8px;
        overflow-x: auto;
      }
    </style>
  </head>
  <body>
    <h1>Telegram Code Catcher</h1>

    {% if snippets %}
      {% for snippet in snippets %}
        <div class="snippet">
          <div class="meta">
            {{ snippet.created_at }} • {{ snippet.language or 'text' }} • user: {{ snippet.username or snippet.user_id }}
          </div>
          <pre>{{ snippet.code }}</pre>
        </div>
      {% endfor %}
    {% else %}
      <p>No snippets captured yet.</p>
    {% endif %}
  </body>
</html>
